# Silva - Micro-Agente Autônomo Offline para Android
# Configurações do Servidor Web e Orquestrador

WEB_HOST=0.0.0.0
WEB_PORT=5000

# PIN de segurança simples para acesso via LAN (opcional; deixe em branco para desativar)
ACCESS_PIN=1234

# Endpoint do llama-server rodando localmente no Termux
LLAMA_SERVER_URL=http://127.0.0.1:8080

# Timeout em segundos para requisições ao llama-server
LLM_TIMEOUT_SECONDS=15

# Diretório para armazenamento de fotos capturadas
CAPTURES_DIR=./captures

# Simular chamadas de hardware caso não esteja rodando no Termux (true para testes no PC)
SIMULATE_HARDWARE=false

# Modo Opcional de Comando por Voz Offline (whisper.cpp + Notificação Persistente)
ENABLE_VOICE_MODE=false
WHISPER_BIN_PATH=
WHISPER_MODEL_PATH=models/ggml-base.bin
WHISPER_LANGUAGE=pt
ENABLE_VOICE_TTS=false

